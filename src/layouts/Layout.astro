---
import '~/assets/styles/tailwind.css';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import Intersect from '~/components/common/Intersect.astro';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

import { enCategoryHref } from '~/navigation';

export interface Props {
  metadata?: MetaDataType;
  lang?: string;
}

const { metadata = {}, lang } = Astro.props;
const { language, textDirection } = I18N;
const pageLang = lang || language;
---

<!doctype html>
<html lang={pageLang} dir={textDirection} class="2xl:text-[19px]">
  <head>
    <CommonMeta />
    <Favicons />
    <!-- 한글 웹폰트 Pretendard (가변, 동적 서브셋) -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />

    <!-- 구글 애드센스 (사이트 확인용 코드, 모든 페이지에 들어갑니다) -->
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8517057986888627"
      crossorigin="anonymous"></script>

    <!-- Cloudflare Web Analytics (방문 통계, 쿠키 없음) -->
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "c667ebb1d2014b32bbc6ae306676b327"}'></script>

    <link rel="preconnect" href="https://images.unsplash.com" />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />

    <!-- Extra head content from pages: structured data, rel=prev/next, … -->
    <slot name="head" />
  </head>

  <body class="antialiased text-default bg-page min-h-screen flex flex-col break-keep">
    {
      pageLang !== 'en' && (
        <div
          id="en-banner"
          hidden
          lang="en"
          class="bg-slate-900 px-4 py-2 text-center text-sm text-white dark:bg-emerald-900"
        >
          <a href={enCategoryHref} class="font-medium underline underline-offset-2">
            Not Korean? Read our English guides for life in Korea →
          </a>
          <button
            type="button"
            id="en-banner-close"
            class="ml-3 align-middle text-slate-300 hover:text-white"
            aria-label="Close"
          >
            ✕
          </button>
        </div>
      )
    }
    <slot />

    <Intersect />
    <script is:inline>
      // 브라우저 언어가 한국어가 아닌 방문자에게만 영어 안내 띠를 보여 줍니다. (자동 이동은 하지 않음)
      (() => {
        const setup = () => {
          const bar = document.getElementById('en-banner');
          if (!bar) return;
          const langs = navigator.languages?.length ? navigator.languages : [navigator.language || ''];
          const korean = langs.some((l) => String(l).toLowerCase().startsWith('ko'));
          let closed = false;
          try {
            closed = localStorage.getItem('enBannerClosed') === '1';
          } catch {
            // 저장소를 못 쓰는 브라우저에서는 매번 보여 줍니다.
          }
          if (korean || closed) return;
          bar.hidden = false;
          const btn = document.getElementById('en-banner-close');
          if (btn)
            btn.onclick = () => {
              bar.hidden = true;
              try {
                localStorage.setItem('enBannerClosed', '1');
              } catch {
                // 무시
              }
            };
        };
        document.addEventListener('astro:page-load', setup);
      })();
    </script>
  </body>
</html>
