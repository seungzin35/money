---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import CoverArt from '~/components/blog/CoverArt.astro';
import SocialShare from '~/components/common/SocialShare.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
---

<section class="py-8 sm:py-16 lg:py-20 mx-auto">
  <article>
    <header class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
      <div class="flex justify-between flex-col sm:flex-row max-w-3xl mx-auto mt-0 mb-2 px-4 sm:px-6 sm:items-center">
        <p>
          <Icon name="tabler:clock" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
          <time datetime={post.publishDate.toISOString()} class="inline-block"
            >{getFormattedDate(post.publishDate)}</time
          >
          {
            post.updateDate && post.updateDate.getTime() !== post.publishDate.getTime() && (
              <>
                {' '}
                ·{' '}
                <span class="inline-block">
                  수정 <time datetime={post.updateDate.toISOString()}>{getFormattedDate(post.updateDate)}</time>
                </span>
              </>
            )
          }
          {
            post.author && (
              <>
                {' '}
                · <Icon name="tabler:user" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
                <span class="inline-block">{post.author}</span>
              </>
            )
          }
          {
            post.category && (
              <>
                {' '}
                ·{' '}
                <a class="hover:underline inline-block" href={getPermalink(post.category.slug, 'category')}>
                  {post.category.title}
                </a>
              </>
            )
          }
          {
            post.readingTime && (
              <>
                &nbsp;· <span>{post.readingTime}</span>분 읽기
              </>
            )
          }
        </p>
        {
          post.asOf && (
            <span class="mt-2 inline-flex items-center gap-1 self-start rounded-md bg-emerald-50 px-2 py-1 text-xs font-semibold text-emerald-800 sm:mt-0 dark:bg-emerald-900/40 dark:text-emerald-300">
              <Icon name="tabler:calendar-check" class="h-4 w-4" />
              {post.asOf.replace('-', '년 ')}월 기준
            </span>
          )
        }
      </div>

      <h1
        class="px-4 sm:px-6 max-w-3xl mx-auto text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading"
      >
        {post.title}
      </h1>
      <p
        class="max-w-3xl mx-auto mt-4 mb-8 px-4 sm:px-6 text-xl md:text-2xl text-muted dark:text-slate-400 text-pretty"
      >
        {post.excerpt}
      </p>

      {
        post.image ? (
          <Image
            src={post.image}
            class="max-w-full lg:max-w-[900px] mx-auto mb-6 sm:rounded-3xl bg-gray-400 dark:bg-slate-700"
            widths={[400, 900]}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post.imageAlt || ''}
            width={900}
            height={506}
            format="webp"
            loading="eager"
            decoding="async"
          />
        ) : (
          <div class="max-w-3xl mx-auto px-4 sm:px-6 mb-6">
            <div class="h-56 overflow-hidden rounded-3xl md:h-72">
              <CoverArt
                category={post.category?.title}
                icon={post.coverIcon}
                title={post.title}
                coverTitle={post.coverTitle}
                coverSub={post.coverSub}
                size="hero"
              />
            </div>
          </div>
        )
      }
    </header>
    <div
      class="mx-auto px-6 sm:px-6 max-w-3xl prose lg:prose-xl dark:prose-invert dark:prose-headings:text-slate-300 prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-primary dark:prose-a:text-emerald-400 prose-img:rounded-md prose-img:shadow-lg mt-8 prose-headings:scroll-mt-[80px] prose-li:my-0"
    >
      <slot />
    </div>
    <aside class="mx-auto mt-10 max-w-3xl px-4 sm:px-6" aria-label="안내">
      <div
        class="flex gap-3 rounded-xl border border-slate-200 bg-white p-5 text-sm text-muted dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400"
      >
        <Icon name="tabler:info-circle" class="h-5 w-5 shrink-0 text-emerald-600 dark:text-emerald-400" />
        <p>
          이 글은 일반적인 정보이며 금융 상품 가입이나 투자를 권유하지 않습니다. 금리·세율 같은 숫자는 바뀔 수 있으니
          결정 전에 공식 기관에서 최신 내용을 확인해 주세요. <a
            class="font-medium text-primary underline"
            href={getPermalink('/disclaimer')}>면책 고지</a
          >
        </p>
      </div>
    </aside>
    <div class="mx-auto px-6 sm:px-6 max-w-3xl mt-8 flex justify-between flex-col sm:flex-row">
      <PostTags tags={post.tags} class="mr-5 rtl:mr-0 rtl:ml-5" />
      <SocialShare url={url} text={post.title} class="mt-5 sm:mt-1 align-middle text-gray-500 dark:text-slate-600" />
    </div>
  </article>
</section>
