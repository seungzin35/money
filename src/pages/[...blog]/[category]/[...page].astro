---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { blogCategoryRobots, getStaticPathsBlogCategory } from '~/utils/blog';

import Layout from '~/layouts/PageLayout.astro';
import { categories, isEnglishCategory } from '~/navigation';
import CategoryNav from '~/components/blog/CategoryNav.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogCategory({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths> & { category: Record<string, string> };

const { page, category } = Astro.props as Props;

const currentPage = page.currentPage ?? 1;

const categoryInfo = categories.find(({ text }) => text === category.title);

const isEn = isEnglishCategory(category.title);
const lang = isEn ? 'en' : undefined;
const pageLabel = isEn ? `Page ${currentPage}` : `${currentPage}페이지`;

const breadcrumbs = [
  { text: isEn ? 'Home' : '홈', href: getPermalink('/') },
  ...(isEn ? [] : [{ text: '블로그', href: getBlogPermalink() }]),
  ...(currentPage > 1
    ? [{ text: category.title, href: getPermalink(category.slug, 'category') }, { text: pageLabel }]
    : [{ text: category.title }]),
];

const metadata = {
  title: `${category.title}${currentPage > 1 ? ` — ${pageLabel}` : ''}`,
  description: isEn
    ? 'Practical English guides for foreigners in Korea: Korean apps, payments, banking, phones and daily life.'
    : `${category.title} 카테고리의 글 모음입니다.`,
  robots: {
    index: blogCategoryRobots?.index && page.data.length > 0,
    follow: blogCategoryRobots?.follow,
  },
};
---

<Layout metadata={metadata} lang={lang}>
  <Breadcrumbs bar items={breadcrumbs} />
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline subtitle={categoryInfo?.description}>{category.title}</Headline>
    {!isEn && <CategoryNav current={category.title} class="-mt-4 mb-12 md:-mt-8" />}
    {
      page.data.length > 0 ? (
        <BlogList posts={page.data} />
      ) : (
        <p class="rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center text-muted dark:border-slate-700 dark:bg-slate-900">
          {isEn ? 'Our first guide is on its way. Check back soon!' : '이 분야의 첫 글을 준비하고 있어요. 곧 올라와요!'}
        </p>
      )
    }
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
  </section>
</Layout>
